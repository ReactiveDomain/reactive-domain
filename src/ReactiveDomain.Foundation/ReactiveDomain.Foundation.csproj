<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- Foundation's transitive closure is Core + Messaging + Persistence, which is exactly what the
         umbrella package has always delivered, so it publishes under that id. The assembly is still
         ReactiveDomain.Foundation; only the package id differs. Renaming either one breaks consumers. -->
    <PackageId>ReactiveDomain</PackageId>
    <Description>A toolkit for implementing CQRS-ES in a reactive system. Installs the ReactiveDomain core: repositories, read models, stream subscriptions and serialization.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="StreamStore\EventStoreMessageLogger.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveDomain.Testing" />
    <InternalsVisibleTo Include="ReactiveDomain.Testing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReactiveDomain.Analyzers\ReactiveDomain.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- RD0001 reaches consumers only through this item, and it fails quietly both ways: the analyzer
         builds to the shared bld directory Directory.Build.props points OutputPath at, not to its own
         bin, and a backslash in the path resolves to nothing on the Linux runner that packs. A miss
         here still produces a package, just one without the analyzer. -->
    <None Include="$(MSBuildThisFileDirectory)../../bld/$(Configuration)/netstandard2.0/ReactiveDomain.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReactiveDomain.Messaging\ReactiveDomain.Messaging.csproj" />
    <ProjectReference Include="..\ReactiveDomain.Persistence\ReactiveDomain.Persistence.csproj" />
  </ItemGroup>
</Project>
