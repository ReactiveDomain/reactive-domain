<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<StartupObject>PolicyTool.Program</StartupObject>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>policytool</ToolCommandName>
		<Description>Command-line tool for administering ReactiveDomain identity and policy streams. Install with dotnet tool install and invoke as policytool.</Description>
		<PackageTags>$(PackageTags) identity policy dotnet-tool</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
		<PackageReference Include="EventStore.Client" Version="22.0.0" />
		<PackageReference Include="System.CommandLine" Version="2.0.10" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ReactiveDomain.IdentityStorage\ReactiveDomain.IdentityStorage.csproj" />
		<ProjectReference Include="..\ReactiveDomain.PolicyStorage\ReactiveDomain.PolicyStorage.csproj" />
		<ProjectReference Include="..\ReactiveDomain.Policy.Core\ReactiveDomain.Policy.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="es_settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>