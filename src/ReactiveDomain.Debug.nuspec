<?xml version="1.0"?>
<package>
	<metadata>
		<id>ReactiveDomain</id>
		<version>0.17.0</version>
		<authors>Reactive Domain Group</authors>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">MIT</license>
		<description>A toolkit for implementing CQRS-ES in a reactive system. Package includes all ReactiveDomain Core assemblies.</description>
		<readme>docs\README.md</readme>
		<tags>CQRS ES event-sourcing messaging</tags>
		<repository type="git" url="https://github.com/ReactiveDomain/reactive-domain" branch="master" />
		<dependencies>
			<group targetFramework="net8.0">
				<dependency id="EventStore.Client" version="21.2.2" exclude="Build,Analyzers" />
				<dependency id="KurrentDB.Client" version="1.4.0" exclude="Build,Analyzers" />
				<dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
				<dependency id="System.Reactive" version="7.0.0" exclude="Build,Analyzers"/>
				<dependency id="System.Configuration.ConfigurationManager" version="10.0.10" exclude="Build,Analyzers" />
				<dependency id="System.Diagnostics.PerformanceCounter" version="10.0.10" exclude="Build,Analyzers" />
			</group>
			<group targetFramework="net10.0">
				<dependency id="EventStore.Client" version="21.2.2" exclude="Build,Analyzers" />
				<dependency id="KurrentDB.Client" version="1.4.0" exclude="Build,Analyzers" />
				<dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
				<dependency id="System.Reactive" version="7.0.0" exclude="Build,Analyzers"/>
				<dependency id="System.Configuration.ConfigurationManager" version="10.0.10" exclude="Build,Analyzers" />
				<dependency id="System.Diagnostics.PerformanceCounter" version="10.0.10" exclude="Build,Analyzers" />
			</group>
		</dependencies>
		<references>
			<group targetFramework="net8.0">
				<reference file="ReactiveDomain.Core.dll" />
				<reference file="ReactiveDomain.Core.xml" />
				<reference file="ReactiveDomain.Foundation.dll" />
				<reference file="ReactiveDomain.Foundation.xml" />
				<reference file="ReactiveDomain.Messaging.dll" />
				<reference file="ReactiveDomain.Messaging.xml" />
				<reference file="ReactiveDomain.Persistence.dll" />
				<reference file="ReactiveDomain.Persistence.xml" />
				<reference file="ReactiveDomain.Transport.dll" />
				<reference file="ReactiveDomain.Transport.xml" />
			</group>
			<group targetFramework="net10.0">
				<reference file="ReactiveDomain.Core.dll" />
				<reference file="ReactiveDomain.Core.xml" />
				<reference file="ReactiveDomain.Foundation.dll" />
				<reference file="ReactiveDomain.Foundation.xml" />
				<reference file="ReactiveDomain.Messaging.dll" />
				<reference file="ReactiveDomain.Messaging.xml" />
				<reference file="ReactiveDomain.Persistence.dll" />
				<reference file="ReactiveDomain.Persistence.xml" />
				<reference file="ReactiveDomain.Transport.dll" />
				<reference file="ReactiveDomain.Transport.xml" />
			</group>
		</references>
	</metadata>
	<files>
