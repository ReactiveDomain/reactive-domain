
<Project Sdk="Microsoft.NET.Sdk">  
  <PropertyGroup>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <RootNamespace>ReactiveDomain</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Core primitives shared by every ReactiveDomain assembly: event sources, stream positions and checkpoints, metadata, logging and utilities.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveDomain.Persistence" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
</Project>